{
  "name": "machinedrum",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Web Audio drum machine with a local Link session bridge",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "serve": "node serve.mjs",
    "link": "node link-bridge.mjs",
    "test": "node link-bridge.test.mjs && node fx.test.mjs && node save.test.mjs",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5",
    "vite": "^7",
    "vite-plugin-pwa": "^1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
